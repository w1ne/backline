    "bench:voice": "vite-node bench/voice/run.ts",
    "bench:voice:output": "vite-node bench/voice/output.ts",
    "bench:patterns": "vite-node bench/patterns/run.ts",
    "bench:harmony": "vite-node bench/harmony/run.ts",
    "bench:realvoice": "vite-node bench/realvoice/run.ts",
    "bench:tempo": "vite-node bench/tempo/run.ts",
    "bench:calibrate": "vite-node bench/calibrate/run.ts",
    "bench:gate": "vite-node bench/gate.ts",
    "smoke:live": "node services/smoke.mjs",
    "samples:amt": "node services/fetch-amt-samples.mjs",
    "predev": "npm run samples:amt",
